{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "plugin": ["opencode-pty"],
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "enabled": true,
      "command": ["npx", "chrome-devtools-mcp@latest", "--autoConnect"],
    },
    "playwright": {
      "type": "local",
      "enabled": true,
      "command": ["npx", "playwright-mcp@latest"],
    },
  },
}
