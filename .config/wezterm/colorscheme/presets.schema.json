{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Presets Configuration Schema",
  "type": "object",
  "properties": {
    "presets": {
      "type": "object",
      "patternProperties": {
        "^[a-zA-Z0-9_-]+$": {
          "type": "object",
          "properties": {
            "wezterm": {
              "$ref": "#/definitions/Colorscheme"
            },
            "neovim": {
              "$ref": "#/definitions/Colorscheme"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "Colorscheme": {
      "type": "object",
      "properties": {
        "light": {
          "type": "string",
          "description": "The name of the light colorscheme."
        },
        "dark": {
          "type": "string",
          "description": "The name of the dark colorscheme."
        }
      }
    }
  }
}
